# For testnet use ONLY. Node does not automatically load this file.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
SERVICE_ID=relayline-gate
PINNED_PUBLISHER=0xYOUR_PUBLISHER_WALLET_ADDRESS
PUBLISHER_PRIVATE_KEY=0xYOUR_TEST_ONLY_PRIVATE_KEY
ATTACKER_PRIVATE_KEY=0xYOUR_OTHER_TEST_ONLY_PRIVATE_KEY
PRIMARY_URL=https://primary.example.org/
FALLBACK_URL=https://recovery.example.org/
REVISION=1
ALLOW_LOOPBACK_TESTS=0

# Optional monitor runner. DO NOT expose as a public URL-probing endpoint.
MONITOR_SERVICE_ID=relayline-gate
MONITOR_ENDPOINT_ID=primary
MONITOR_APPROVED_URL=https://your-controlled-site.example/
# Set YES deliberately only when willing to spend test GLM on a signed observation.
MONITOR_PUBLISH=NO
MONITOR_PRIVATE_KEY=0xANOTHER_TEST_ONLY_KEY
